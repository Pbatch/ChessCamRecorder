{
  "name": "@chesscam/recorder",
  "version": "0.1.0",
  "description": "Record chess games from a camera or video of a real board, in the browser. Moves as SAN/PGN, on-device.",
  "keywords": [
    "chess",
    "pgn",
    "chessboard",
    "board-recognition",
    "move-detection",
    "camera",
    "computer-vision",
    "tflite"
  ],
  "homepage": "https://www.chesscam.net",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pbatch/ChessCamRecorder.git"
  },
  "bugs": "https://github.com/Pbatch/ChessCamRecorder/issues",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/test"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "vitest run",
    "tsc": "tsc",
    "lint": "biome lint src --error-on-warnings",
    "check": "npm test && npm run tsc && npm run lint",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@litertjs/core": "2.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
