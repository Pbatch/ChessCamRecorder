{
  "name": "chesscam-recorder",
  "version": "0.1.0",
  "description": "Records chess moves from a camera or video of a real board, in the browser",
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=26"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/test"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "vitest run",
    "tsc": "tsc",
    "lint": "biome lint src --error-on-warnings",
    "check": "npm test && npm run tsc && npm run lint"
  },
  "dependencies": {
    "@litertjs/core": "2.6.0",
    "chessops": "^0.15.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
